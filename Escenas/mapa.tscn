[sub_resource type="GDScript" id="GDScript_634gq"]
script/source = "# GestorOrdenes.gd
extends Node

var unidades_seleccionadas: Array = []

func _input(event):
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		if unidades_seleccionadas.size() > 0:
			var click_pos = get_viewport().get_mouse_position()
			var mundo_pos = get_tree().current_scene.get_global_mouse_position()
			
			for unidad in unidades_seleccionadas:
				if unidad.has_method(\"orden_mover_a\"):
					unidad.orden_mover_a(mundo_pos)

func seleccionar_unidad(unidad):
	if not unidad in unidades_seleccionadas:
		unidades_seleccionadas.append(unidad)

func deseleccionar_unidad(unidad):
	unidades_seleccionadas.erase(unidad)

func deseleccionar_todo():
	unidades_seleccionadas.clear()
"

